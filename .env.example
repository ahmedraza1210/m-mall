# Password for /admin. REQUIRED on Vercel.
ADMIN_PASSWORD=change-me
# Optional: a long random string used to sign admin logins. Changing it logs everyone out.
ADMIN_SECRET=
# Added automatically by Vercel when you connect a Blob store. Leave empty locally
# to save content in ./data/db.json and images in ./public/uploads instead.
BLOB_READ_WRITE_TOKEN=
